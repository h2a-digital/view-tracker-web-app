# Reuse the EXISTING Creator Ledger Supabase project. Never use a marketing app database.
# Set these in Vercel Project Settings > Environment Variables, Production only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only secret (legacy SUPABASE_SERVICE_ROLE_KEY is also supported).
SUPABASE_SECRET_KEY=
# Must match the existing Auth user AND public.admin_users entry.
ADMIN_EMAIL=
# Canonical production HTTPS origin, no path; localhost is for local development only.
APP_URL=http://localhost:3000
# Server only; reuse the current Free account and its existing TikTok connection.
ZERNIO_API_KEY=
# Server only: generate a random secret of at least 32 characters.
# Must match the Supabase Vault secret ugc_cron_secret.
CRON_SECRET=
