# Reuse the EXISTING Creator Ledger Supabase project. Never use a marketing app database.
# Set these in Netlify Project configuration > Environment variables, Production only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only secret (legacy SUPABASE_SERVICE_ROLE_KEY is also supported).
SUPABASE_SECRET_KEY=
# Must match the existing Auth user AND public.admin_users entry.
ADMIN_EMAIL=
# Canonical production HTTPS origin, no path; localhost is for local development only.
APP_URL=http://localhost:3000
# Server only; reuse the current Free account and its existing TikTok connection.
ZERNIO_API_KEY=
# Server only: generate a random secret of at least 32 characters.
# Must match the Supabase Vault secret ugc_cron_secret.
CRON_SECRET=

# Deployment context is generated at build time; do not set APP_DEPLOYMENT_ENV manually.
# Netlify UI build setting: AWS_LAMBDA_JS_RUNTIME=nodejs22.x (not needed locally).

# Optional direct integrations. Leave blank until the provider app is configured.
# Server-only encryption key: 64 random hexadecimal characters. Keep a secure backup.
OAUTH_TOKEN_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
# Set a supported Graph version explicitly, e.g. v26.0; confirm with your Meta app.
META_GRAPH_VERSION=
# If Facebook Login for Business requires a configuration ID, copy it here.
META_LOGIN_CONFIG_ID=
# Intentionally displayed on public privacy/deletion pages; use a company support address.
PUBLIC_SUPPORT_EMAIL=
# Enable ONLY after explicit policy review/approval, not merely OAuth verification.
YOUTUBE_ANALYTICS_POLICY_APPROVED=false
# Enable ONLY after checking current Meta definitions and a boosted/unboosted pilot.
INSTAGRAM_ORGANIC_VIEWS_VERIFIED=false
FACEBOOK_ORGANIC_VIEWS_VERIFIED=false
# API-version-dependent candidate; validate on your Page before production.
FACEBOOK_REEL_VIEW_METRIC=fb_reels_total_plays
# Optional supported metric names; leave blank if unavailable. Never substitute zero.
FACEBOOK_REEL_ORGANIC_METRIC=
FACEBOOK_REEL_PAID_METRIC=
